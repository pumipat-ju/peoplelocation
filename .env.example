# Host directory mounted read-only at /app/weights in the backend container.
MODEL_WEIGHTS_DIR=./weights

# Durable identity database stored inside the backend data mount.
IDENTITY_DB_PATH=/app/data/identity_memory.sqlite3

# Production OSNet runtime configuration inside the backend container.
# Supply the checkpoint through ./weights; model weights are never committed.
REID_ENABLED=true
REID_CHECKPOINT_PATH=/app/weights/osnet_x1_0_peoplelocation_balanced_v2.pth
REID_DEVICE=auto
REID_CROP_MODE=improved

# Keep similarity-only shortcuts disabled until a held-out validation report
# is production-ready. Use validated only after reviewing that report.
REID_THRESHOLD_SAFETY_MODE=conservative

# Delay before retrying a disconnected webcam/RTSP capture.
LIVE_CAMERA_RECONNECT_INTERVAL_SEC=1.0
